{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "permissions": {
    "defaultMode": "acceptEdits",

    "allow": [
      "Bash(*)",
      "PowerShell(*)",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "TodoWrite",
      "NotebookEdit"
    ],

    "deny": [
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -f /*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(git rm *)",
      "Bash(git branch -D *)",
      "Bash(gh repo delete *)",
      "Bash(gh release delete *)",
      "Bash(gh api --method DELETE *)",
      "Bash(gh api --method POST *)",
      "Bash(gh api --method PATCH *)",
      "Bash(gh api --method PUT *)",
      "Bash(gh api -X *)",
      "Bash(gh secret *)",
      "Bash(chmod 777 *)",
      "Bash(curl * | sh *)",
      "Bash(curl * | bash *)",
      "Bash(wget * | sh *)",
      "Bash(wget * | bash *)",
      "Bash(npm publish *)",
      "Bash(shutdown *)",

      "PowerShell(Remove-Item * -Recurse *)",
      "PowerShell(Remove-Item -Recurse *)",
      "PowerShell(Format-Volume *)",
      "PowerShell(Clear-Disk *)",
      "PowerShell(Stop-Computer *)",
      "PowerShell(Set-ExecutionPolicy *)"
    ]
  }
}
