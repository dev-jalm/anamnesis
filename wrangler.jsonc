{
  // Configuración para desplegar Anamnesis en Cloudflare como sitio estático.
  //
  // Va por Workers con "static assets" y no por Pages porque las cuentas
  // nuevas de Cloudflare ya no ofrecen el flujo de Pages: al importar un
  // repositorio, el panel lleva directamente a Workers.
  //
  // En Cloudflare Pages este archivo no corre código: ahí lo hace la carpeta
  // functions/, que envuelve el mismo Worker. Quedan las dos para que
  // funcione en cualquiera de los dos modos de publicación.
  //
  // Un único Worker, y sólo para /api/*: trae los datos de Finviz, que el
  // navegador no puede pedir directo (CORS). Todo lo demás son archivos de
  // "assets". No hay build step — el proyecto es HTML, CSS y JS planos, así
  // que el Build command del panel tiene que quedar VACÍO.
  "name": "anamnesis",
  "main": "worker/fundamentales.mjs",
  "compatibility_date": "2026-07-28",

  "assets": {
    // Todo el repositorio. No hay carpeta de build que apuntar.
    "directory": "./",

    // El Worker corre primero sólo para /api/*; el resto se sirve directo.
    "run_worker_first": ["/api/*"],

    // Una URL desconocida devuelve el index.html en vez de un 404 crudo.
    // Como index.html redirige al dashboard, cualquier ruta termina en la app.
    "not_found_handling": "single-page-application"
  }
}
